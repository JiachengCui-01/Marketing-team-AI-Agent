# DeepSeek — powers the orchestrator, OA copilot, and all sub-agents.
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key

# Google Gemini — does double duty:
#   1. product-image generation (gemini-2.5-flash-image)
#   2. web search for the research agent and the daily briefing, via Google
#      Search grounding. DeepSeek has no built-in web search, so without this
#      (or a dedicated search key below) the research agent reports that
#      research is unavailable instead of inventing sources.
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Live competitor-page extraction uses Playwright/Chromium. Disable only when
# running in an environment without a browser binary.
MARKETING_AGENT_PRODUCT_BROWSER=1
# Keep one Chromium session at a time on the 2 GB Render instance.
# MARKETING_AGENT_BROWSER_CONCURRENCY=1
# Usually required in hosted containers. Keep unset locally when Chromium's
# normal sandbox works.
# MARKETING_AGENT_BROWSER_NO_SANDBOX=1

# Optional: a dedicated search vendor. Setting one takes priority over Gemini
# grounding, because these APIs return publication dates that grounding does not.
#   TAVILY_API_KEY / SERPER_API_KEY / BRAVE_SEARCH_API_KEY / BOCHA_API_KEY
TAVILY_API_KEY=

# Optional model overrides (defaults shown).
# DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_FAST_MODEL=deepseek-v4-flash
# DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
# MARKETING_AGENT_GEMINI_SEARCH_MODEL=gemini-3.6-flash
# Pin a provider explicitly: tavily | serper | brave | bocha | gemini
# MARKETING_AGENT_SEARCH_PROVIDER=gemini
